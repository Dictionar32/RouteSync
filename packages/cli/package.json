{
  "name": "@routesync/cli",
  "version": "1.0.0",
  "description": "CLI tool for scanning Laravel/PHP routes and generating typed SDKs",
  "bin": {
    "routesync": "./dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@routesync/core": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0"
  },
  "license": "MIT"
}

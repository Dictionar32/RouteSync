{
  "name": "@routesync/sdk",
  "version": "1.0.0",
  "description": "Developer-facing SDK for RouteSync",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {

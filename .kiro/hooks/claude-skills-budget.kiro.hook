{
  "name": "Claude Skills — budget watch",
  "description": "Managed by Claude Skills Manager (claude-skills-budget)",
  "version": "1",
  "enabled": true,
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:37677/hook/budget?agent=kiro&cwd=%2Fhome%2Fannas-zen%2FDocuments%2FRouteSync\" || true",
    "timeout": 8
  }
}
